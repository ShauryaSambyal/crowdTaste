# Copy this file to `.env` and paste your own keys.
# `.env` is git-ignored; `.env.example` is committed as documentation.
#
# 1) Google Places API (New)  - https://console.cloud.google.com/
#    Enable "Places API (New)" + billing, then create an API key.
# 2) Yelp Fusion - written reviews for venues mapped in OpenStreetMap.
#    https://docs.developer.yelp.com/docs/places-intro - create an app, copy
#    the API key. Yelp ended its free tier in 2024, so this needs a paid plan.
#    Without it, search, hours, photos and Compare still run keylessly on
#    OpenStreetMap; only written review text is missing.

# Optional: adds ratings, review counts and written reviews on Google-sourced
# results. A Maps Demo Key (card-free) gives ratings only.
GOOGLE_PLACES_API_KEY=

# Optional: written reviews for mapped venues via Yelp Fusion.
YELP_API_KEY=

# Optional tuning
# LIVE_REQUEST_TIMEOUT_MS=12000
# NOMINATIM_CONTACT_EMAIL=you@example.com

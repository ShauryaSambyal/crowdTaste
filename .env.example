# Copy this file to `.env` and paste your own keys.
# `.env` is git-ignored; `.env.example` is committed as documentation.
#
# 1) Google Places API (New)  - https://console.cloud.google.com/
#    Enable "Places API (New)" + billing, then create an API key.
# 2) Spoonacular Food API     - https://spoonacular.com/food-api (free tier,
#    no credit card required; backlink required on the free plan).
#    Your key lives in https://spoonacular.com/food-api/console

GOOGLE_PLACES_API_KEY=
SPOONACULAR_API_KEY=

# Optional tuning
# LIVE_REQUEST_TIMEOUT_MS=12000
# LIVE_CACHE_TTL_MS=300000
